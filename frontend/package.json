{
  "name": "cibseven-components",
  "version": "2.3.0-dev.24",
  "type": "module",
  "license": "",
  "main": "./src/main.js",
  "style": "dist/cibseven-components.css",
  "files": [
    "dist/cibseven-components.css",
    "dist/cibseven-components.es.js",
    "dist/cibseven-components.umd.js",
    "src/plugins/pluginImportMap.js",
    "src/themes"
  ],
  "exports": {
    ".": {
      "import": "./dist/cibseven-components.es.js",
      "require": "./dist/cibseven-components.umd.js"
    },
    "./vite": "./src/plugins/pluginImportMap.js",
    "./themes/*": "./src/themes/*",
    "./dist/cibseven-components.css": "./dist/cibseven-components.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:library": "cross-env BUILD_MODE=library vite build",
    "build:library:watch": "cross-env BUILD_MODE=library vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:report": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@bpmn-io/form-js": "1.21.3",
    "@cib/bootstrap-theme": "1.0.3-dev.4",
