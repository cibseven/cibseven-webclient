    "@mdi/font": "7.4.47",
    "apexcharts": "4.7.0",
    "axios": "1.18.1",
    "bootstrap": "5.3.8",
    "bpm-sdk": "2.1.3",
    "bpmn-js": "18.14.0",
    "cibseven-modeler": "1.3.0-dev.9",
    "dmn-js": "17.7.0",
    "js-abbreviation-number": "1.4.0",
    "js-sha256": "0.11.1",
    "moment": "2.30.1",
    "platform": "1.3.6",
    "vue": "3.5.33",
    "vue-global-events": "3.0.1",
    "vue-i18n": "11.4.0",
    "vue-router": "5.0.6",
    "vue3-apexcharts": "1.8.0",
    "vuex": "4.1.0"
  },
  "peerDependencies": {
    "axios": "^1.18.1",
